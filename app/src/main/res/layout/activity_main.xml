<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#1E1E1E">

        <!-- Top toolbar -->
        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#2D2D2D"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:text="☰"
                android:textColor="#CCCCCC"
                android:textSize="20sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/fileName"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="untitled.html"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:singleLine="true"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/btnConsole"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:text=">_"
                android:textColor="#CCCCCC"
                android:textSize="16sp"
                android:gravity="center"/>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Save"
                android:textSize="12sp"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btnRun"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:text="▶"
                android:textSize="14sp"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/btnRunMenu"
                android:layout_width="28dp"
                android:layout_height="36dp"
                android:text="▾"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:background="#1976D2"
                android:gravity="center"/>

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:text="⚙"
                android:textColor="#CCCCCC"
                android:textSize="18sp"
                android:gravity="center"/>

        </LinearLayout>

        <!-- File tabs -->
        <HorizontalScrollView
            android:id="@+id/tabScrollView"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#252525"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tabContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"/>

        </HorizontalScrollView>

        <!-- Find / Replace panel -->
        <LinearLayout
            android:id="@+id/findPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#252526"
            android:padding="6dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/findInput"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="#1E1E1E"
                    android:hint="Find"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:singleLine="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="#D4D4D4"
                    android:textColorHint="#858585"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/findCount"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="64dp"
                    android:gravity="center"
                    android:text="0/0"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/findPrev"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="▲"
                    android:textColor="#CCCCCC"
                    android:background="?android:attr/selectableItemBackground"/>

                <TextView
                    android:id="@+id/findNext"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="▼"
                    android:textColor="#CCCCCC"
                    android:background="?android:attr/selectableItemBackground"/>

                <TextView
                    android:id="@+id/findClose"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#CCCCCC"
                    android:background="?android:attr/selectableItemBackground"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/findCase"
                    android:layout_width="34dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="Aa"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/findWord"
                    android:layout_width="34dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="W"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/findRegex"
                    android:layout_width="34dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text=".*"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"/>

                <EditText
                    android:id="@+id/replaceInput"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#1E1E1E"
                    android:hint="Replace"
                    android:inputType="text"
                    android:singleLine="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="#D4D4D4"
                    android:textColorHint="#858585"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/findReplace"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:gravity="center"
                    android:text="Replace"
                    android:textColor="#52AAF8"
                    android:textSize="13sp"
                    android:background="?android:attr/selectableItemBackground"/>

                <TextView
                    android:id="@+id/findReplaceAll"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:gravity="center"
                    android:text="All"
                    android:textColor="#52AAF8"
                    android:textSize="13sp"
                    android:background="?android:attr/selectableItemBackground"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Code editor (scrolls by itself) -->
        <com.rams.editor.CodeEditor
            android:id="@+id/codeEditor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Console panel -->
        <LinearLayout
            android:id="@+id/consolePanel"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#252526">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="12dp"
                    android:text="CONSOLE"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/consoleClear"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:text="🗑"
                    android:textColor="#CCCCCC"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/consoleClose"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:text="✕"
                    android:textColor="#CCCCCC"
                    android:gravity="center"/>
            </LinearLayout>

            <ScrollView
                android:id="@+id/consoleScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/consoleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:fontFamily="monospace"
                    android:textColor="#D4D4D4"
                    android:textSize="12sp"/>
            </ScrollView>
        </LinearLayout>

        <!-- Snippet row 1 — context aware -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#252525"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/snippetRow1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"/>

        </HorizontalScrollView>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"/>

        <!-- Snippet row 2 — fixed symbols -->
        <LinearLayout
            android:id="@+id/snippetBar2"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#1E1E1E"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/snippetRow2"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"/>

            </HorizontalScrollView>

            <TextView
                android:id="@+id/keyFind"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Find"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:background="?android:attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/keyGoto"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Ln"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:background="?android:attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/keyLeft"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="◀"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:background="?android:attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/keyRight"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="▶"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:background="?android:attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/keyUp"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="▲"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:background="?android:attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/keyDown"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="▼"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:background="?android:attr/selectableItemBackground"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Drawer content — file tree -->
    <include
        layout="@layout/drawer_file_tree"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"/>

</androidx.drawerlayout.widget.DrawerLayout>