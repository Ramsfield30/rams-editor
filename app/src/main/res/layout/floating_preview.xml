<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="0dp">

    <!-- Phone + side buttons -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Phone body -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="6dp"
            android:padding="4dp"
            android:background="@drawable/phone_frame">

            <!-- Screen -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@drawable/phone_screen"
                android:clipToOutline="true">

                <!-- Status bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:background="@drawable/status_bar_bg"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/previewTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="9:41"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"/>

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_status_wifi"/>

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_status_signal"/>

                    <ImageView
                        android:id="@+id/previewBattery"
                        android:layout_width="18dp"
                        android:layout_height="11dp"
                        android:layout_marginStart="5dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_status_battery"/>

                </LinearLayout>

                <!-- Page -->
                <FrameLayout
                    android:id="@+id/previewWebHolder"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <WebView
                        android:id="@+id/previewWebView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </FrameLayout>

                <!-- Home bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:background="@drawable/home_bar_bg"
                    android:gravity="center">

                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:background="@drawable/home_pill"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Dynamic Island -->
            <View
                android:layout_width="40dp"
                android:layout_height="11dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="5dp"
                android:background="@drawable/camera_hole"/>

        </FrameLayout>

        <!-- Power button (right) -->
        <View
            android:layout_width="4dp"
            android:layout_height="34dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="62dp"
            android:layout_marginEnd="2dp"
            android:background="#7A766C"/>

        <!-- Action button + volume (left) -->
        <View
            android:layout_width="4dp"
            android:layout_height="10dp"
            android:layout_gravity="start|top"
            android:layout_marginTop="34dp"
            android:layout_marginStart="2dp"
            android:background="#7A766C"/>
        <View
            android:layout_width="4dp"
            android:layout_height="22dp"
            android:layout_gravity="start|top"
            android:layout_marginTop="56dp"
            android:layout_marginStart="2dp"
            android:background="#7A766C"/>
        <View
            android:layout_width="4dp"
            android:layout_height="22dp"
            android:layout_gravity="start|top"
            android:layout_marginTop="82dp"
            android:layout_marginStart="2dp"
            android:background="#7A766C"/>

        <!-- Close badge -->
        <TextView
            android:id="@+id/btnClose"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:gravity="center"
            android:text="✕"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/close_badge"/>

    </FrameLayout>

</LinearLayout>