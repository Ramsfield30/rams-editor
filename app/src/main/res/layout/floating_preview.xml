<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/preview_container"
    android:padding="0dp">

    <!-- Preview toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:background="#1A1A2E">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Preview"
            android:textColor="#6666AA"
            android:textSize="11sp"
            android:gravity="center_vertical"/>

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="✕"
            android:textSize="14sp"
            android:textColor="#FF5F57"
            android:gravity="center"/>

    </LinearLayout>

    <!-- Phone body -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="6dp"
        android:padding="5dp"
        android:background="@drawable/phone_frame">

        <!-- Screen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/phone_screen"
            android:clipToOutline="true">

            <!-- Status bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:background="@drawable/status_bar_bg"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/previewTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="9:41"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_status_wifi"/>

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_status_signal"/>

                <ImageView
                    android:id="@+id/previewBattery"
                    android:layout_width="18dp"
                    android:layout_height="11dp"
                    android:layout_marginStart="5dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_status_battery"/>

            </LinearLayout>

            <!-- Page -->
            <FrameLayout
                android:id="@+id/previewWebHolder"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <WebView
                    android:id="@+id/previewWebView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>

            <!-- Home bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:background="@drawable/home_bar_bg"
                android:gravity="center">

                <View
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:background="@drawable/home_pill"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Punch-hole camera -->
        <View
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="7dp"
            android:background="@drawable/camera_hole"/>

    </FrameLayout>

</LinearLayout>