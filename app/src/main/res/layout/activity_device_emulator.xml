<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E3E3E3">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#F7F8FC"
        android:elevation="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/emuClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#1A1D24"
            android:textSize="22sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="24dp"
            android:singleLine="true"
            android:text="Device Emulator"
            android:textColor="#1A1D24"
            android:textSize="19sp"/>

        <TextView
            android:id="@+id/emuHelp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="?"
            android:textColor="#1A1D24"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/emuMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#1A1D24"
            android:textSize="24sp"/>
    </LinearLayout>

    <!-- Device and size controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#CDD2DA"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/emuDevice"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Responsive ▾"
            android:textColor="#1A1D24"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/emuWidth"
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:inputType="number"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:selectAllOnFocus="true"
            android:textColor="#1A1D24"
            android:textSize="17sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="×"
            android:textColor="#3A3F4A"
            android:textSize="20sp"/>

        <EditText
            android:id="@+id/emuHeight"
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:inputType="number"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:selectAllOnFocus="true"
            android:textColor="#1A1D24"
            android:textSize="17sp"/>

        <TextView
            android:id="@+id/emuApply"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="#1A1D24"
            android:textSize="22sp"/>
    </LinearLayout>

    <!-- Stage: the page is shown inside a rounded frame -->
    <FrameLayout
        android:id="@+id/emuStage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#E3E3E3">

        <FrameLayout
            android:id="@+id/emuFrame"
            android:layout_width="375dp"
            android:layout_height="667dp"
            android:background="#FFFFFF"
            android:elevation="6dp">

            <WebView
                android:id="@+id/emuWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>

        <!-- Drag to change the width -->
        <LinearLayout
            android:id="@+id/emuHandleRight"
            android:layout_width="26dp"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center">

            <View
                android:layout_width="3dp"
                android:layout_height="48dp"
                android:background="#4B5563"/>

            <View
                android:layout_width="3dp"
                android:layout_height="48dp"
                android:layout_marginStart="5dp"
                android:background="#4B5563"/>
        </LinearLayout>

        <!-- Drag to change the height -->
        <LinearLayout
            android:id="@+id/emuHandleBottom"
            android:layout_width="72dp"
            android:layout_height="26dp"
            android:orientation="vertical"
            android:gravity="center">

            <View
                android:layout_width="48dp"
                android:layout_height="3dp"
                android:background="#4B5563"/>

            <View
                android:layout_width="48dp"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:background="#4B5563"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Size presets -->
    <HorizontalScrollView
        android:id="@+id/emuChipScroll"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#CDD2DA"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/emuChips"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </HorizontalScrollView>
</LinearLayout>