<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2D2D2D"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/emuBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_back"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Device Emulator"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/emuSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Responsive"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:singleLine="true"/>
        </LinearLayout>

        <TextView
            android:id="@+id/emuRefresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="⟳"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#252526"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/emuDevice"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="#1E1E1E"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Responsive ▾"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:singleLine="true"/>

        <EditText
            android:id="@+id/emuWidth"
            android:layout_width="58dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="#1E1E1E"
            android:gravity="center"
            android:inputType="number"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:selectAllOnFocus="true"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="×"
            android:textColor="#AAAAAA"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/emuHeight"
            android:layout_width="58dp"
            android:layout_height="36dp"
            android:background="#1E1E1E"
            android:gravity="center"
            android:inputType="number"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:selectAllOnFocus="true"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <ImageView
            android:id="@+id/emuRotate"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_rotate"/>
    </LinearLayout>

    <!-- Stage -->
    <FrameLayout
        android:id="@+id/emuStage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#2B2B2B">

        <WebView
            android:id="@+id/emuWebView"
            android:layout_width="360dp"
            android:layout_height="640dp"/>
    </FrameLayout>

    <!-- Size chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#252526">

        <TextView
            android:id="@+id/emuChipS"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="S · 320"
            android:textColor="#CCCCCC"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/emuChipM"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="M · 375"
            android:textColor="#CCCCCC"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/emuChipL"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="L · 435"
            android:textColor="#CCCCCC"
            android:textSize="13sp"/>
    </LinearLayout>
</LinearLayout>