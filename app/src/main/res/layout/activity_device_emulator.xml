<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2D2D2D"
        android:elevation="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/emuClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#E6E6E6"
            android:textSize="22sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="24dp"
            android:singleLine="true"
            android:text="Device Emulator"
            android:textColor="#E6E6E6"
            android:textSize="19sp"/>

        <TextView
            android:id="@+id/emuConsoleBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text=">_"
            android:textColor="#E6E6E6"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/emuHelp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="?"
            android:textColor="#E6E6E6"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/emuMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#E6E6E6"
            android:textSize="24sp"/>
    </LinearLayout>

    <!-- Device and size controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#252526"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/emuDevice"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Responsive ▾"
            android:textColor="#E6E6E6"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/emuWidth"
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:inputType="number"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:selectAllOnFocus="true"
            android:textColor="#E6E6E6"
            android:textSize="17sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="×"
            android:textColor="#B0B6C2"
            android:textSize="20sp"/>

        <EditText
            android:id="@+id/emuHeight"
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:inputType="number"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:selectAllOnFocus="true"
            android:textColor="#E6E6E6"
            android:textSize="17sp"/>

        <TextView
            android:id="@+id/emuApply"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="#E6E6E6"
            android:textSize="22sp"/>
    </LinearLayout>

    <!-- Stage: the page is shown inside a rounded frame -->
    <FrameLayout
        android:id="@+id/emuStage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E1E1E">

        <FrameLayout
            android:id="@+id/emuFrame"
            android:layout_width="375dp"
            android:layout_height="667dp"
            android:background="#FFFFFF"
            android:elevation="6dp">

            <WebView
                android:id="@+id/emuWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>

        <!-- Drag to change the width -->
        <LinearLayout
            android:id="@+id/emuHandleRight"
            android:layout_width="26dp"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center">

            <View
                android:layout_width="3dp"
                android:layout_height="48dp"
                android:background="#8A94A6"/>

            <View
                android:layout_width="3dp"
                android:layout_height="48dp"
                android:layout_marginStart="5dp"
                android:background="#8A94A6"/>
        </LinearLayout>

        <!-- Drag to change the height -->
        <LinearLayout
            android:id="@+id/emuHandleBottom"
            android:layout_width="72dp"
            android:layout_height="26dp"
            android:orientation="vertical"
            android:gravity="center">

            <View
                android:layout_width="48dp"
                android:layout_height="3dp"
                android:background="#8A94A6"/>

            <View
                android:layout_width="48dp"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:background="#8A94A6"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Console -->
    <LinearLayout
        android:id="@+id/emuConsolePanel"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#252526">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:text="CONSOLE"
                android:textColor="#CCCCCC"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/emuConsoleCopy"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="COPY"
                android:textColor="#2196F3"
                android:textSize="11sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/emuConsoleClear"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:text="🗑"
                android:textColor="#CCCCCC"
                android:gravity="center"/>

            <TextView
                android:id="@+id/emuConsoleClose"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:text="✕"
                android:textColor="#CCCCCC"
                android:gravity="center"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:background="#1E1E1E">

            <TextView
                android:id="@+id/emuFilterAll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="All"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:gravity="center"/>

            <TextView
                android:id="@+id/emuFilterInfo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Info"
                android:textSize="12sp"
                android:textColor="#AAAAAA"
                android:gravity="center"/>

            <TextView
                android:id="@+id/emuFilterWarning"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Warning"
                android:textSize="12sp"
                android:textColor="#AAAAAA"
                android:gravity="center"/>

            <TextView
                android:id="@+id/emuFilterError"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Error"
                android:textSize="12sp"
                android:textColor="#AAAAAA"
                android:gravity="center"/>
        </LinearLayout>

        <ScrollView
            android:id="@+id/emuConsoleScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/emuConsoleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:fontFamily="monospace"
                android:textColor="#D4D4D4"
                android:textSize="12sp"/>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#252526">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:text="›"
                android:textColor="#2196F3"
                android:textSize="20sp"/>

            <EditText
                android:id="@+id/emuConsoleInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="monospace"
                android:hint="Type JavaScript…"
                android:imeOptions="actionGo"
                android:inputType="textNoSuggestions"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="#D4D4D4"
                android:textColorHint="#777777"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/emuConsoleUp"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="▲"
                android:textColor="#AAAAAA"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/emuConsoleDown"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="▼"
                android:textColor="#AAAAAA"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/emuConsoleRun"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="▶"
                android:textColor="#2196F3"
                android:textSize="18sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Size presets -->
    <HorizontalScrollView
        android:id="@+id/emuChipScroll"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#252526"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/emuChips"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </HorizontalScrollView>
</LinearLayout>