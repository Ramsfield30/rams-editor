<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#252525">

        <TextView
            android:id="@+id/gitBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="←"
            android:textColor="#DDDDDD"
            android:textSize="20sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Git"
            android:textColor="#DDDDDD"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/gitRefresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="⟳"
            android:textColor="#DDDDDD"
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/gitSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#DDDDDD"
            android:textSize="20sp"/>
    </LinearLayout>

    <!-- Branch + remote -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/gitBranch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="…"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/gitRemote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:text=""
            android:textColor="#888888"
            android:textSize="12sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/gitChangesTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#252525"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="CHANGES"
        android:textColor="#BBBBBB"
        android:textSize="11sp"
        android:letterSpacing="0.1"/>

    <!-- Changed files -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/gitChangeList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <Button
        android:id="@+id/gitInit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="#0E639C"
        android:text="Initialize repository"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:visibility="gone"/>

    <!-- Commit area -->
    <LinearLayout
        android:id="@+id/gitCommitBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <EditText
            android:id="@+id/gitMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Commit message"
            android:minLines="2"
            android:maxLines="4"
            android:inputType="textMultiLine|textCapSentences"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:textSize="14sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/gitCommit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#0E639C"
                android:text="Commit"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/gitPush"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#0E639C"
                android:text="Push"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/gitPull"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#0E639C"
                android:text="Pull"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/gitStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#252525"
        android:minHeight="36dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text=""
        android:textColor="#BBBBBB"
        android:textSize="12sp"/>
</LinearLayout>