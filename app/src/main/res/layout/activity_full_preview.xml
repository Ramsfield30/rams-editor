<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2D2D2D"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/previewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preview"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:singleLine="true"
                android:ellipsize="end"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preview · 100% Zoom"
                android:textColor="#AAAAAA"
                android:textSize="13sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/btnPreviewConsole"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text=">_"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/btnPreviewRefresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="⟳"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/btnPreviewMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="⋮"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Page -->
    <WebView
        android:id="@+id/previewWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Console panel -->
    <LinearLayout
        android:id="@+id/fsConsolePanel"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#252526">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:text="CONSOLE"
                android:textColor="#CCCCCC"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/fsConsoleClear"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:text="🗑"
                android:textColor="#CCCCCC"
                android:gravity="center"/>

            <TextView
                android:id="@+id/fsConsoleClose"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:text="✕"
                android:textColor="#CCCCCC"
                android:gravity="center"/>
        </LinearLayout>

        <ScrollView
            android:id="@+id/fsConsoleScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/fsConsoleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:fontFamily="monospace"
                android:textColor="#D4D4D4"
                android:textSize="12sp"/>
        </ScrollView>
    </LinearLayout>
</LinearLayout>