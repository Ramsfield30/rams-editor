<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2D2D2D"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/btnPreviewBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_back"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/previewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preview"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:singleLine="true"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/previewSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="index.html"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:singleLine="true"/>
        </LinearLayout>

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <TextView
                android:id="@+id/btnPreviewConsole"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text=">_"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center"/>

            <View
                android:id="@+id/consoleErrorDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/dot_red"
                android:visibility="gone"/>
        </FrameLayout>

        <TextView
            android:id="@+id/btnPreviewRefresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="⟳"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/btnPreviewMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="⋮"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Page -->
    <WebView
        android:id="@+id/previewWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Console panel -->
    <LinearLayout
        android:id="@+id/fsConsolePanel"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#252526">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:text="CONSOLE"
                android:textColor="#CCCCCC"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/fsConsoleCopy"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="COPY"
                android:textColor="#2196F3"
                android:textSize="11sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/fsConsoleClear"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:text="🗑"
                android:textColor="#CCCCCC"
                android:gravity="center"/>

            <TextView
                android:id="@+id/fsConsoleClose"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:text="✕"
                android:textColor="#CCCCCC"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Filters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:background="#1E1E1E">

            <TextView
                android:id="@+id/fsFilterAll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="All"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:gravity="center"/>

            <TextView
                android:id="@+id/fsFilterInfo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Info"
                android:textSize="12sp"
                android:textColor="#AAAAAA"
                android:gravity="center"/>

            <TextView
                android:id="@+id/fsFilterWarning"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Warning"
                android:textSize="12sp"
                android:textColor="#AAAAAA"
                android:gravity="center"/>

            <TextView
                android:id="@+id/fsFilterError"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Error"
                android:textSize="12sp"
                android:textColor="#AAAAAA"
                android:gravity="center"/>
        </LinearLayout>

        <ScrollView
            android:id="@+id/fsConsoleScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/fsConsoleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:fontFamily="monospace"
                android:textColor="#D4D4D4"
                android:textSize="12sp"/>
        </ScrollView>

        <!-- Type a command -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#252526">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:text="›"
                android:textColor="#2196F3"
                android:textSize="20sp"/>

            <EditText
                android:id="@+id/fsConsoleInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="monospace"
                android:hint="Type JavaScript…"
                android:imeOptions="actionGo"
                android:inputType="textNoSuggestions"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="#D4D4D4"
                android:textColorHint="#777777"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/fsConsoleUp"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="▲"
                android:textColor="#AAAAAA"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/fsConsoleDown"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="▼"
                android:textColor="#AAAAAA"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/fsConsoleRun"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="▶"
                android:textColor="#2196F3"
                android:textSize="18sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>